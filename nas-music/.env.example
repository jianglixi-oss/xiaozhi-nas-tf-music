# Official XiaoZhi MCP endpoint. Keep it local; never commit the token.
MCP_ENDPOINT=wss://api.xiaozhi.me/mcp/?token=REPLACE_ME
NAS_MUSIC_DIR=/vol1/1000/Music
MUSIC_DIR=/music
# NAS LAN IP reachable directly by your Waveshare board, NOT the container IP.
MUSIC_BASE_URL=http://192.168.1.10:8765
MUSIC_PORT=8765
MUSIC_SIGNING_KEY=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS

# Optional HomePod bridge. Keep the real HA token private.
HOME_ASSISTANT_URL=http://homeassistant.local:8123
HOME_ASSISTANT_TOKEN=
HOME_ASSISTANT_PLAYERS={}
